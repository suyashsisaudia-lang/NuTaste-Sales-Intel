# Copy to .env for local development. NEVER commit a real .env file.
# Generate the two hashes and a secret key with:  python -m app.hash_password

SITE_PASSWORD_HASH=
ADMIN_PASSWORD_HASH=
SECRET_KEY=

DATA_DIR=./data
SESSION_HOURS=12
ADMIN_SESSION_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
MAX_UPLOAD_MB=64

# Set to false ONLY for local http:// testing. Must be true in production.
SECURE_COOKIES=true

# ---------------------------------------------------------------- Ask box (AI)
# Optional. Leave GEMINI_API_KEY blank and the Ask box works exactly as before,
# using its built-in parser. Get a key from https://aistudio.google.com/apikey
# and paste it below — it is read from the environment and never leaves the
# server. The model only classifies the question; all amounts are computed in
# the browser from your own data.
ASK_AI_ENABLED=true
ASK_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# 0 = no internal reasoning (fastest and cheapest, and right for this task).
# Use -1 for dynamic. Gemini Pro models require at least 128.
GEMINI_THINKING_BUDGET=0
ASK_TIMEOUT_SECONDS=12
ASK_MAX_PER_WINDOW=40
ASK_WINDOW_SECONDS=300
ASK_MAX_QUESTION_CHARS=400

# Write a plain-English summary above each answer (a SECOND call per question).
# This is the only setting that sends computed amounts to the provider; the
# question-understanding call never does. Set false to keep figures internal.
ASK_NARRATE=true

# ------------------------------------------- Secondary Sales weekly refresh
# SharePoint share link to the "Secondary Sale" workbook. Treat it like a
# password: it is an "Anyone with the link" share. Blank = no auto-refresh.
SEC_SOURCE_URL=
SEC_REFRESH_ENABLED=true
# 0 = Monday ... 6 = Sunday; time is in the offset below (330 = IST)
SEC_REFRESH_WEEKDAY=0
SEC_REFRESH_TIME=11:00
SEC_REFRESH_UTC_OFFSET_MINUTES=330
