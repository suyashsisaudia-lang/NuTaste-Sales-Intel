# Copy to .env for local development. NEVER commit a real .env file.
# Generate the two hashes and a secret key with:  python -m app.hash_password

SITE_PASSWORD_HASH=
ADMIN_PASSWORD_HASH=
SECRET_KEY=

DATA_DIR=./data
SESSION_HOURS=12
ADMIN_SESSION_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
MAX_UPLOAD_MB=64

# Set to false ONLY for local http:// testing. Must be true in production.
SECURE_COOKIES=true
